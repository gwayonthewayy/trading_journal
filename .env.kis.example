# Start in paper/shadow mode. Never commit the real .env.kis file.
KIS_ENV=paper
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_HTS_ID=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_PAPER_ACCOUNT_NO=
KIS_SYNC_ENABLED=false
KIS_WRITE_EVENTS=false
KIS_ORDER_ENABLED=false
KIS_POLL_SECONDS=60
